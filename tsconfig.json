{
  "compilerOptions": {
    "target": "es2020",
    "module": "es2020",
    "rootDir": "main/opengeometry-three",
    "outDir": "dist",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "main/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "main/opengeometry-three/examples-vite"
  ]
}
